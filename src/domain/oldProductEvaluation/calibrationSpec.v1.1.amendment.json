    "formulas": {
      "wape": "sum(abs(pred-actual))/sum(abs(actual))",
      "mae": "mean(abs(pred-actual))",
      "smape": "mean(case_term_where_case_term_is_0_when_pred_and_actual_are_both_0_else_2*abs(pred-actual)/(abs(pred)+abs(actual)))",
      "signedAggregateBias": "(sum(pred)-sum(actual))/sum(actual)",
      "servedWorkShare": "count(distinct_standard_work_id_x_origin_with_at_least_one_served_core_horizon_case)/count(distinct_standard_work_id_x_origin_with_at_least_one_statisticallyScoreable_core_horizon_case)",
      "servedActualRevenueShare": "sum(max(actual,0)_for_servedCohort)/sum(max(actual,0)_for_allScoreable)",
      "topBandServedRevenueShare": "sum(max(actual,0)_for_servedCohort_and_band)/sum(max(actual,0)_for_allScoreable_and_band)",
      "abstainedActualRevenueShare": "sum(max(actual,0)_for_abstainedCohort)/sum(max(actual,0)_for_allScoreable)",
      "endToEndBusinessLoss": "sum(abs(coalesce(servedPrediction,0)-actual)_for_allScoreable)/sum(abs(actual)_for_allScoreable)"
    },
    "undefinedWhen": {
      "wape": "sum(abs(actual))==0",
      "signedAggregateBias": "sum(actual)<=0",
      "revenueShare": "sum(max(actual,0)_in_denominator)==0"
    },
