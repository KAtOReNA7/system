M1_APP_ENV=local
M1_HTTP_PORT=3000

# Local development/test only.
# Copy this file to .env.local or run tools/dev-db/New-M1LocalEnvFile.ps1.
# Keep .env.local local to each computer. Do not commit real credentials,
# production/staging/shared hosts, real bills, ledgers, ops confirmations, or database files.
M1_LOCAL_DEV_ENVIRONMENT_NAME=m1-local-dev
M1_LOCAL_DRY_RUN_ENVIRONMENT_NAME=m1-local-dry-run
M1_LOCAL_DB_HOST=127.0.0.1
M1_LOCAL_DEV_DB_PORT=55432
M1_LOCAL_DRY_RUN_DB_PORT=55433
M1_LOCAL_DEV_DB_NAME=m1_local_dev
M1_LOCAL_DRY_RUN_DB_NAME=m1_local_dry_run

# Leave password and URL values blank in committed templates.
M1_POSTGRES_ADMIN_USER=postgres
M1_POSTGRES_ADMIN_PASSWORD=
M1_MIGRATION_OWNER_PASSWORD=
M1_APPLICATION_RW_PASSWORD=
M1_APPLICATION_RO_PASSWORD=
M1_BACKGROUND_WORKER_PASSWORD=
M1_BACKUP_OPERATOR_PASSWORD=

M1_DATABASE_URL=
M1_DATABASE_READONLY_URL=
M1_DATABASE_BACKGROUND_URL=
