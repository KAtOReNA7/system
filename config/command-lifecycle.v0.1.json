{
  "schemaVersion": "repository.command-lifecycle.v0.1",
  "purpose": "Keep current onboarding small while retaining audit-bound historical entrypoints.",
  "principles": {
    "newDevelopmentMustUseCurrentPublicCommands": true,
    "archiveCommandsDoNotGrantAuthorization": true,
    "restrictedCommandsRequireTheirOwningCapabilityAndAuthorization": true,
    "legacyPackageEntriesRemainOnlyForAuditCompatibility": true
  },
  "currentPublicCommands": [
    "dev",
    "start",
    "start:fixture",
    "doctor:dev",
    "lint",
    "build",
    "test",
    "test:unit",
    "test:current-contract",
    "test:archive",
    "test:private",
    "test:all",
    "test:toolchain-contract",
    "test:secret-guard",
    "test:e2e",
    "smoke",
    "smoke:portable-start",
    "check:no-real-data",
    "diagnose:m2:current",
    "diagnose:m2:signal-input",
    "verify:m2:signal-input",
    "verify:m2:current"
  ],
  "historyDispatcher": "history:m2",
  "archiveOnlyPrefixes": [
    "m2:v2:",
    "test:m2-",
    "replay:m2:",
    "fit:m2:",
    "audit:m2:",
    "validate:m2:",
    "evaluate:m2:",
    "compare:m2:",
    "verify:m2:"
  ],
  "restrictedPrefixes": [
    "doctor:capability",
    "develop:m2:",
    "m3:",
    "db:",
    "import:",
    "review:",
    "apply:",
    "dry-run:",
    "execute:",
    "generate:",
    "precheck:",
    "prepare:",
    "recover:",
    "rerun:",
    "summarize:",
    "summary:",
    "audit:m1:",
    "verify:m1:",
    "check:m2"
  ]
}
