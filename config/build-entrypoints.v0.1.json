{
  "schema": "project.build-entrypoints.v0.1",
  "requiredTrackedFiles": [
    "src/server.js",
    "src/http/app.js",
    "src/config.js",
    "public/admin/index.html",
    "public/admin/app.js",
    "public/admin/app.css"
  ],
  "importChecks": [
    {
      "path": "src/http/app.js",
