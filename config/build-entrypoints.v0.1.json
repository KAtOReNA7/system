        "createApp"
      ]
    },
    {
      "path": "src/config.js",
      "requiredExports": [
        "ConfigError",
        "loadConfig"
      ]
    }
  ],
  "packageEntrypoints": {
    "start": "src/server.js",
    "dev": "src/server.js"
  }
}
