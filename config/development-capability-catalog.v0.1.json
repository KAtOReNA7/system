        {
          "id": "git",
          "command": "git",
          "versionArgs": ["--version"]
        },
        {
          "id": "node",
          "runtime": "node",
          "minimumMajor": 24,
          "maximumMajor": 24,
          "recommendedMajor": 24
        },
        {
          "id": "npm",
          "command": "npm",
          "versionArgs": ["--version"],
          "exactVersion": "11.13.0",
          "recommended": "11.13.0"
        },
        {
          "id": "python",
          "command": "python",
          "versionArgs": ["--version"],
          "minimumMajor": 3,
          "minimumMinor": 11,
          "maximumMajor": 3,
          "maximumMinor": 13,
          "recommended": "3.13"
        }
      ],
      "requiredPrivateArtifacts": [],
      "canonicalValidationCommands": [
        "npm run check:no-real-data",
        "npm run lint",
        "npm run build",
        "npm test",
        "npm run smoke"
      ],
      "authorization": "NORMAL_REPOSITORY_DEVELOPMENT"
    },
