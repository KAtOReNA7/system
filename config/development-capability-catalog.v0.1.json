{
  "schemaVersion": "development-capability-catalog.v0.1",
  "catalogVersion": "2026-07-23",
  "principles": {
    "coreDevelopmentMustNotRequirePrivateArtifacts": true,
    "missingPrivateArtifactsBlockOnlyOwningCapability": true,
    "privateArtifactsMustNotBeCommittedOrFabricated": true,
