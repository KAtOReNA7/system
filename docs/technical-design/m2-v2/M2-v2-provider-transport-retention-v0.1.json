{
  "schema": "m2.v2.provider-transport-retention-public.v0.1",
  "status": "IMPLEMENTED_AND_SYNTHETICALLY_VERIFIED",
  "classification": "public_sanitized_not_for_formal_decision",
  "scope": ["all_executable_search_routes", "all_executable_relay_routes", "all_responses_payload_builders"],
  "endpointRules": {
    "parsedWithUrl": true,
    "protocol": "https:",
    "userinfoAllowed": false,
    "fragmentAllowed": false,
    "localhostOrPrivateIpAllowed": false,
    "syntheticAdapterException": "explicit_in_memory_test_adapter_only",
