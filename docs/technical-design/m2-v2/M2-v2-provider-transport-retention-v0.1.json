    "legacyMutableCacheCount": 0,
    "rawResponseCurrentCacheCount": 0,
    "providerHostBindingVerified": true
  },
  "tests": ["http_rejected", "userinfo_rejected", "host_mismatch_rejected", "redirect_mismatch_rejected", "store_missing_rejected", "store_true_rejected", "approved_https_passes", "key_not_in_error"],
  "verificationScope": {
    "syntheticBoundaryTests": "verified",
    "realPrivateMigrationClaimed": false,
    "exactHeadCiClaimed": false,
    "publicRestatementClaimed": false
  },
  "authorization": {
    "providerDispatchAuthorized": false,
    "full160Authorized": false,
    "nextDevelopmentReadiness": "NOT_AUTHORIZED"
  }
}
