  "implementationFindings": [
    {
      "findingId": "EVAL-IMP-001",
      "status": "CURRENT_FORMULAS_CORRECT",
      "severity": "INFORMATIONAL",
      "evidence": [
        "src/domain/m2Current/metrics.js"
      ],
      "findingZh": "当前 JavaScript 作品级 WAPE 与有向偏差严格使用绝对实际现金分母；负冲销进入分母，零实际值仍贡献误差，全零分母会关闭失败。",
      "action": "PRESERVE_AND_VERSION_DEFINITION"
    },
    {
      "findingId": "EVAL-IMP-002",
      "status": "HISTORICAL_METRIC_DEFINITION_MISMATCH",
      "severity": "MATERIAL_CAVEAT",
      "evidence": [
        "scripts/m2-real-data/m2_calibration_v1.py",
        "src/domain/m2Current/metrics.js"
      ],
      "findingZh": "历史 Python signedAggregateBias 使用净实际总额作分母，不能与当前 JavaScript signed bias 当作同一指标。",
      "action": "REQUIRE_METRIC_DEFINITION_ID_ON_FUTURE_EVALUATIONS"
    },
    {
      "findingId": "EVAL-IMP-003",
      "status": "MISLABELED_PARTIAL_CAPABILITY",
      "severity": "MATERIAL_CAVEAT",
      "evidence": [
        "src/domain/m2Current/metrics.js",
        "src/domain/m2Current/lifecycleAware.js"
      ],
      "findingZh": "通用评价器 positiveAmount 实际计算正实际值子集上的最终 pointEstimate 误差，不读取独立 conditionalAmountPrediction；生命周期专用实现才保存真正的发生与条件金额分解。",
      "action": "DO_NOT_INTERPRET_GENERIC_POSITIVE_AMOUNT_AS_CONDITIONAL_AMOUNT"
    },
    {
      "findingId": "EVAL-IMP-004",
      "status": "AGGREGATION_CANCELLATION_EXPLICIT",
      "severity": "MATERIAL_CAVEAT",
      "evidence": [
        "src/domain/m2Current/portfolio.js"
      ],
      "findingZh": "组合聚合会抵消作品级高估与低估；组合准确不能证明作品点预测准确。",
      "action": "REPORT_WORK_AND_PORTFOLIO_RESOLUTIONS_SIDE_BY_SIDE"
    },
    {
      "findingId": "EVAL-IMP-005",
      "status": "HORIZON_POOLING_WEIGHTING_RISK",
      "severity": "MATERIAL_CAVEAT",
      "evidence": [
        "src/domain/m2Current/metrics.js",
        "src/domain/m2Current/portfolio.js"
      ],
      "findingZh": "跨 horizon 池化 WAPE 按实际现金规模自然加权，累计 horizon 还会重复使用月份，不能作为未经授权的统一排序。",
      "action": "MAKE_HORIZON_STRATIFIED_RESULTS_PRIMARY"
    },
    {
      "findingId": "EVAL-IMP-006",
      "status": "REGISTRY_METRIC_DEFINITION_ID_GAP",
      "severity": "GOVERNANCE_GAP",
      "evidence": [
        "config/m2-model-registry.v1.json"
      ],
      "findingZh": "登记成绩具有人口、目标、粒度与窗口，但每条 evaluation 尚未携带可机读的 metricDefinitionId。",
      "action": "ADD_ONLY_IN_A_SEPARATELY_AUTHORIZED_SCHEMA_MIGRATION"
    },
    {
      "findingId": "EVAL-IMP-007",
      "status": "HISTORICAL_FORENSIC_WAPE_VARIANT",
      "severity": "MATERIAL_CAVEAT",
      "evidence": [
        "scripts/m2-real-data/run_m2_c3_development_validation.py"
