  "scientificQuestion": {
    "text": "Using only origin-visible work-channel cash history and frozen static mechanism mapping, do membership, advertising and transactional mechanisms provide stable out-of-time incremental value beyond frozen learnedGlobal when represented by independent temporal generation processes?",
    "questionOne": "Does an independent occurrence-times-conditional-amount generator add value?",
    "questionTwo": "Does a mechanism-specific dynamic residual add value when frozen learnedGlobal is used only as a structured offset?",
    "mustRemainSeparatelyReported": true
  },
  "hypotheses": {
    "H0": {
      "statement": "Mechanism labels and temporal structure provide no stable out-of-time incremental value over frozen learnedGlobal with the currently available data.",
      "status": "TO_TEST"
    },
    "H1_M": {
      "statement": "Membership cash is associated with a smoother active state and slower future decay driven by recent level and continuity.",
      "status": "TO_TEST_NOT_ASSUMED_TRUE"
    },
    "H1_A": {
      "statement": "Advertising cash has shorter memory, higher variability and stronger recent-trend or peak-recency dynamics in both occurrence and conditional amount.",
      "status": "TO_TEST_NOT_ASSUMED_TRUE"
    },
    "H1_T": {
      "statement": "Transactional cash has sparse purchase occurrence, a short spike and a longer tail that require separate occurrence and conditional-amount processes.",
      "status": "TO_TEST_NOT_ASSUMED_TRUE"
    },
    "failureInterpretation": "If correctly specified G1 and G2 fail the frozen gates, accept that current data do not support implementable incremental mechanism value; do not continue unbounded tuning."
