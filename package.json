{
  "name": "m1-audiobook-evaluation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:check": "node src/cli/check-db.js",
    "lint": "node tools/node/check-syntax.mjs",
    "build": "node tools/node/check-syntax.mjs",
    "test": "node --test test/admin.test.js test/api.test.js test/config.test.js test/db-query.test.js test/health.test.js test/m2-old-product-api.test.js test/m2-old-product-evaluation-engine.test.js test/m2-calibrated-parameters.test.js test/m2-b3-no-db-readiness.test.js test/m2-b3-no-db-validation-report-generator.test.js test/m2-local-dry-run-manifest-validator.test.js test/m2-formal-persistence-schema.test.js test/m2-formal-readiness-gate.test.js test/m2-blocking-review-workflow.test.js test/m2-evaluation-task-workflow.test.js test/m2-advisory-review-display.test.js test/m2-export-release-gate.test.js test/m2-real-data-development-candidate.test.js test/m2-real-data-db-import-plan.test.js test/m2-review-decision-closure.test.js test/m2-review-remediation-plan.test.js test/m2-forecast-scenario-calibration.test.js test/smoke-safety.test.js test/fixtures/syntheticBusinessData.js test/fixtures/m2OldProductEvaluationFixtureCases.js",
    "test:e2e": "node --test test/e2e/admin.e2e.test.js",
    "smoke": "node tools/dev-smoke/run-api-smoke.mjs",
    "check:no-real-data": "node scripts/check-no-real-data.mjs",
    "check:m2-b3:no-db-readiness": "node scripts/check-m2-b3-no-db-readiness.mjs",
    "check:m2:formal-readiness:fixture": "node scripts/check-m2-formal-readiness-fixture.mjs",
    "generate:m2-b3:no-db-validation-report": "node scripts/generate-m2-b3-no-db-validation-report.mjs",
    "validate:m2:local-dry-run-manifest": "node scripts/validate-m2-local-dry-run-manifest.mjs",
    "evaluate:m2:old-products:fixture": "node scripts/run-m2-old-product-fixture-evaluation.mjs",
    "evaluate:m2:old-products:calibrated": "node scripts/run-m2-old-product-fixture-evaluation.mjs --profile calibrated_non_formal",
    "compare:m2:old-products:calibration": "node scripts/run-m2-old-product-fixture-evaluation.mjs --compare-profiles",
    "evaluate:m2:real-data:dev": "python scripts/m2-real-data/run_authorized_real_data_development.py",
    "evaluate:m2:state-machine": "node scripts/m2-real-data/run_m2_state_machine_evaluation.mjs",
    "import:m2:real-data:local-db": "node scripts/m2-real-data/run_authorized_real_data_db_import.mjs --clear",
    "review:m2:candidate-b:local": "node scripts/m2-real-data/run_candidate_b_review_workflow.mjs",
    "review:m2:candidate-b:export-pack": "node scripts/m2-real-data/run_candidate_b_review_decision_apply.mjs --export-pack",
    "review:m2:candidate-b:apply": "node scripts/m2-real-data/run_candidate_b_review_decision_apply.mjs",
    "review:m2:candidate-b:summary": "node scripts/m2-real-data/run_candidate_b_review_decision_apply.mjs --summary",
    "review:m2:candidate-b:export-group-template": "node scripts/m2-real-data/run_candidate_b_review_decision_apply.mjs --export-group-template",
    "review:m2:candidate-b:group-summary": "node scripts/m2-real-data/run_candidate_b_review_decision_apply.mjs --summary",
    "review:m2:candidate-b:group-apply": "node scripts/m2-real-data/run_candidate_b_review_decision_apply.mjs",
    "review:m2:candidate-b:remediate-data-gaps": "node scripts/m2-real-data/run_candidate_b_review_remediation.mjs",
    "validate:m2:candidate-b:20-works": "python scripts/m2-real-data/run_candidate_b_prd_algorithm_validation.py",
    "validate:m2:candidate-b:prd-algorithm": "python scripts/m2-real-data/run_candidate_b_prd_algorithm_validation.py",
    "validate:m2:candidate-b:forecast-spread": "python scripts/m2-real-data/run_candidate_b_prd_algorithm_validation.py",
    "validate:m2:candidate-b:forecast-calibrated": "python scripts/m2-real-data/run_candidate_b_prd_algorithm_validation.py",
    "validate:m2:candidate-b:forecast-rebuilt": "python scripts/m2-real-data/run_candidate_b_prd_algorithm_validation.py"
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "playwright": "^1.61.0"
  }
}
